/*
 * Keebart Corne Choc Pro BT — 46-Key Variant
 *
 * Same layout philosophy as the Standard Corne (42-key) keymap:
 *   0=BASE 1=GAME 2=NUM 3=SYM 4=NAV 5=SYS
 *   Thumbs: NAV | NUM | SPC | RET | SYM | SYS
 *
 * Differences vs corne.keymap:
 *   - 46 positions per layer (4 encoder click slots in middle)
 *   - Encoder positions (6, 7, 20, 21) bound to &none — no encoders fitted
 *   - All hand positions shifted right by +2 (top/home) or +4 (home-r/bot/thumbs)
 *
 * SPDX-License-Identifier: GPL-2.0-or-later
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// 46-Key Keebart layout — encoder click positions (6, 7, 20, 21) excluded from hold-trigger
#define HM_L_POSITIONS  8  9 10 11 12 13 22 23 24 25 26 27 34 35 36 37 38 39
#define HM_R_POSITIONS  0  1  2  3  4  5 14 15 16 17 18 19 28 29 30 31 32 33

#include "corne_common.dtsi"

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: BASE (QWERTY mit Home Row Mods)
        base_layer {
            label = "BASE";
            bindings = <
&kp ESC    &kp Q          &kp W         &kp E          &kp R         &kp T      &none  &none  &kp Y      &kp U          &kp I          &kp O         &kp P             &kp BSPC
&kp TAB    &hm_l LGUI A   &hm_l LALT S  &kp D          &hm_l LCTRL F &kp G      &none  &none  &kp H      &hm_r RCTRL J  &kp K          &hm_r RALT L  &hm_r RGUI SEMI   &kp SQT
&kp LSHFT  &kp Z          &kp X         &kp C          &kp V         &kp B                    &kp N      &kp M          &kp COMMA      &kp DOT       &kp FSLH          &kp RSHFT
                                        &mo 4          &mo 2         &kp SPACE                &kp RET    &mo 3          &mo 5
            >;
        };

        // Layer 1: GAME (CS) — Toggle: SYS + G
        // Home Row Mods aus, LCTRL (Ducken) auf dem äußeren linken Daumen statt NAV
        game_layer {
            label = "GAME";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans
&trans  &kp A   &kp S   &trans  &kp F   &trans     &trans  &trans  &trans  &kp J   &trans  &kp L   &kp SEMI  &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans    &trans
                        &kp LCTRL  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        // Layer 2: NUMBERS
        number_layer {
            label = "NUMBERS";
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5     &none  &none   &kp N6    &kp N7     &kp N8     &kp N9   &kp N0    &trans
&trans  &none   &none   &none   &none   &none      &none  &none   &kp PLUS  &kp MINUS  &kp STAR   &kp FSLH &kp EQUAL &none
&trans  &none   &none   &none   &none   &none                     &none     &none      &kp COMMA  &kp DOT  &none     &trans
                        &trans  &trans  &trans                    &trans    &trans     &trans
            >;
        };

        // Layer 3: SYMBOL
        symbol_layer {
            label = "SYMBOL";
            bindings = <
&kp GRAVE &kp EXCL  &kp AT   &kp HASH  &kp DLLR  &kp PRCNT  &none  &none  &kp LT    &kp GT    &kp EQUAL  &kp SQT    &kp DQT    &trans
&trans    &kp CARET &kp AMPS &kp PIPE  &kp BSLH  &kp QMARK  &none  &none  &kp LPAR  &kp RPAR  &kp LBRC   &kp RBRC   &kp DOT    &trans
&trans    &kp UNDER &kp SEMI &kp PLUS  &kp TILDE &kp STAR                 &kp LBKT  &kp RBKT  &kp MINUS  &kp COLON  &kp FSLH   &trans
                             &trans    &trans    &trans                   &trans    &trans    &trans
            >;
        };

        // Layer 4: NAVIGATION
        nav_layer {
            label = "NAV";
            bindings = <
&none   &none      &none      &none       &none      &none    &none  &none  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp DEL       &trans
&none   &kp LGUI   &kp LALT   &none       &kp LCTRL  &none    &none  &none  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp UP_ARROW  &none
&trans  &none      &none      &none       &none      &none                  &none     &none      &none      &kp LEFT   &kp DOWN      &kp RIGHT
                              &trans      &trans     &trans                 &trans    &trans     &trans
            >;
        };

        // Layer 5: SYSTEM
        system_layer {
            label = "SYS";
            bindings = <
&none       &kp F1        &kp F2        &kp F3  &kp F4  &kp F5    &none  &none  &kp F6      &kp F7        &kp F8        &kp F9  &kp F10  &kp PSCRN
&none       &none         &none         &none   &none   &tog 1    &none  &none  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &none   &none    &none
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none   &out OUT_TOG                   &none       &none         &none         &none   &none    &none
                                        &trans  &trans  &trans                  &trans      &trans        &trans
            >;
        };
    };
};
