/*
 * Corne 3x6 TypeScript Layout with Home Row Mods
 * Layer order: 0=BASE 1=NUM 2=SYM 3=NAV 4=SYS
 * Thumb cluster: NAV | NUM | SPC | RET | SYM | SYS
 *
 * Symbol Layer Design (SYM = rechter Daumen):
 *
 * Frequenz-Analyse: 784 TS/TSX Dateien aus ycm2
 *   . 20468  ( 16415  ) 16414  ' 14168  / 11265
 *   { 10083  } 10083  : 8195   = 8159   - 7823
 *   > 5589   < 2725   _ 2482   [ 1106   ] 1106
 *   ? 831    ; 12628 (Prettier fügt auto ein → de facto niedrig)
 *
 * Prinzipien:
 *   1. Home Row rechts: ( ) { } .  — Top-5 auf besten Positionen
 *   2. Numbers-Konsistenz: ! @ # $ % auf Q W E R T (Shift+1-5)
 *                          ^ & auf Y U (Shift+6-7)
 *   3. => als Rollover: > (Y-Index-Top) dann = (I-Ring-Top), rechte Hand
 *   4. - nach rechts (N-Bottom): kein Handwechsel mehr
 *   5. ' auf O-Top (war P-Top): eine Spalte näher, Rang 4
 *
 * SPDX-License-Identifier: GPL-2.0-or-later
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        // Home Row Mods - macOS optimiert

        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35>;  // Rechte Hand + Daumen
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29>;  // Linke Hand + Daumen
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: BASE (QWERTY mit Home Row Mods)

        base_layer {
            label = "BASE";
            bindings = <
&kp ESC    &kp Q          &kp W         &kp E          &kp R         &kp T        &kp Y    &kp U         &kp I          &kp O         &kp P             &kp BSPC
&kp TAB    &hm_l LCTRL A  &hm_l LALT S  &hm_l LSHFT D  &hm_l LGUI F  &kp G        &kp H    &hm_r RGUI J  &hm_r RSHFT K  &hm_r RALT L  &hm_r RCTRL SEMI  &kp SQT
&kp LSHFT  &kp Z          &kp X         &kp C          &kp V         &kp B        &kp N    &kp M         &kp COMMA      &kp DOT       &kp FSLH          &kp RSHFT
                                        &mo 3          &mo 1         &kp SPACE    &kp RET  &mo 2         &mo 4
            >;
        };

        // Layer 1: NUMBERS
        //
        // Top:   1-5 links, 6-0 rechts (wie QWERTY Zahlenreihe)
        // Home:  Operatoren: + - * / =
        // Bot:   , . für Dezimalzahlen rechts

        number_layer {
            label = "NUMBERS";
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6    &kp N7     &kp N8     &kp N9    &kp N0     &trans
&trans  &none   &none   &none   &none   &none     &kp PLUS  &kp MINUS  &kp STAR   &kp FSLH  &kp EQUAL  &none
&trans  &none   &none   &none   &none   &none     &none     &none      &kp COMMA  &kp DOT   &none      &trans
                        &trans  &trans  &trans    &trans    &trans     &trans
            >;
        };

        // Layer 2: SYMBOL (Rechtshänder-optimiert für TypeScript/React)
        //
        // SYM = rechter Daumen → Tipp-Hand = rechte Finger
        //
        // Rechte Seite:
        //   Top:  <  >  =  '  "    ← <> Paar benachbart (Roll), => Rollover Index→Ring
        //   Home: (  )  {  }  .    ← Top-5 auf Home Row, null Streckung
        //   Bot:  [  ]  -  :  /    ← [] Paar benachbart (Roll), - : / häufige Operatoren
        //
        // Linke Seite:
        //   ESC:  `                ← Backtick direkt (Template Literals häufiger als ~)
        //   Top:  !  @  #  $  %   ← Shift+1-5, gleiche Position wie Zahlen im NUM Layer
        //   Home: ^  &  |  \  ?   ← ^ auf Pinky-Home, Union, Pipe, Optional
        //   Bot:  _  ;  +  ~  *   ← ~ Shell, * Multiplikation/Spread
        //
        // Rolls: <> (Y+U), => (Y→I), () (H+J), {} (K+L), [] (N+M)

        symbol_layer {
            label = "SYMBOL";
            bindings = <
&kp GRAVE  &kp EXCL   &kp AT    &kp HASH  &kp DLLR   &kp PRCNT    &kp LT    &kp GT    &kp EQUAL  &kp SQT    &kp DQT   &trans
&trans     &kp CARET  &kp AMPS  &kp PIPE  &kp BSLH   &kp QMARK    &kp LPAR  &kp RPAR  &kp LBRC   &kp RBRC   &kp DOT   &trans
&trans     &kp UNDER  &kp SEMI  &kp PLUS  &kp TILDE  &kp STAR     &kp LBKT  &kp RBKT  &kp MINUS  &kp COLON  &kp FSLH  &trans
                                &trans    &trans     &trans       &trans    &trans    &trans
            >;
        };

        // Layer 3: NAVIGATION (Vim-style + macOS shortcuts)

        nav_layer {
            label = "NAV";
            bindings = <
&none  &none      &none     &none      &none     &none     &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp DEL       &trans
&none  &kp LCTRL  &kp LALT  &kp LSHFT  &kp LGUI  &none     &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp UP_ARROW  &none
&none  &none      &none     &none      &none     &none     &none     &none      &none      &kp LEFT   &kp DOWN      &kp RIGHT
                            &trans     &trans    &trans    &trans    &trans     &trans
            >;
        };

        // Layer 4: SYSTEM (F-Keys, Volume, Bluetooth)
        //
        // Top:   F1-F5 links | F6-F10 rechts, Print auf BSPC-Slot
        // Home:  Mute Vol- Vol+ rechts
        // Bot:   BT0 BT1 BT_CLR links

        system_layer {
            label = "SYS";
            bindings = <
&none       &kp F1        &kp F2        &kp F3  &kp F4  &kp F5    &kp F6      &kp F7        &kp F8        &kp F9  &kp F10  &kp PSCRN
&none       &none         &none         &none   &none   &none     &kp K_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &none   &none    &none
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &none   &none   &none     &none       &none         &none         &none   &none    &none
                                        &trans  &trans  &trans    &trans      &trans        &trans
            >;
        };
    };
};
