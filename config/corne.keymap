/*
 * Corne 3x6 TypeScript Layout with Home Row Mods
 * Optimized based on codebase analysis
 *
 * Häufigste Sonderzeichen:
 * . (13.5%), () (22.2%), ' (9.7%), ; (8.6%), / (7.7%), , (7.6%), {} (13.4%), : (6.6%)
 *
 * SPDX-License-Identifier: GPL-2.0-or-later
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        // Combos deaktiviert - zu oft versehentlich ausgelöst
        // Bei Bedarf einzelne Combos wieder aktivieren
        /*
        // Arrow Function => (1,878 Vorkommen)
        combo_arrow {
            timeout-ms = <50>;
            key-positions = <15 16>;  // D+F
            bindings = <&arrow_macro>;
            layers = <0>;
        };

        // Empty Parens () (5,050 Vorkommen)
        combo_parens {
            timeout-ms = <50>;
            key-positions = <14 15>;  // S+D
            bindings = <&parens_macro>;
            layers = <0>;
        };

        // Empty Braces {} (3,094 Vorkommen)
        combo_braces {
            timeout-ms = <50>;
            key-positions = <19 20>;  // J+K
            bindings = <&braces_macro>;
            layers = <0>;
        };

        // Empty Brackets []
        combo_brackets {
            timeout-ms = <50>;
            key-positions = <20 21>;  // K+L
            bindings = <&brackets_macro>;
            layers = <0>;
        };
        */
    };

    macros {
        // Arrow Function: =>

        arrow_macro: arrow_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
        };

        // Parens with cursor inside: ()←

        parens_macro: parens_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
        };

        // Braces with cursor: {}←

        braces_macro: braces_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
        };

        // Brackets with cursor: []←

        brackets_macro: brackets_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
        };
    };

    behaviors {
        // Home Row Mods - macOS optimiert

        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35>;  // Rechte Hand + Daumen
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29>;  // Linke Hand + Daumen
            hold-trigger-on-release;
        };

        // Layer-Tap für Daumen (Numbers)

        lt_spc: layer_tap_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        // Mod-Morph: Space normal/hold=Numbers, Shift+Space hold=Nav

        space_nav: space_navigation {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&lt_spc 2 SPACE>, <&mo 3>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Tap-Dance für System Layer auf R-Shift

        td_rshift: tap_dance_right_shift {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RSHFT>, <&tog 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: BASE (QWERTY mit Home Row Mods)

        base_layer {
            label = "BASE";
            bindings = <
&kp ESC    &kp Q          &kp W         &kp E         &kp R     &kp T         &kp Y      &kp U     &kp I         &kp O         &kp P             &kp BSPC
&kp TAB    &hm_l LCTRL A  &hm_l LALT S  &hm_l LGUI D  &kp F     &kp G         &kp H      &kp J     &hm_r RALT K  &hm_r RGUI L  &hm_r RCTRL SEMI  &kp SQT
&kp LSHFT  &kp Z          &kp X         &kp C         &kp V     &kp B         &kp N      &kp M     &kp COMMA     &kp DOT       &kp FSLH          &td_rshift
                                        &kp LALT      &kp LGUI  &space_nav    &lt 1 RET  &kp LGUI  &kp RCTRL
            >;
        };

        // Layer 1: SYMBOL (TypeScript-optimiert nach Häufigkeit)

        symbol_layer {
            label = "SYMBOL";
            bindings = <
&kp TILDE  &kp EXCL  &kp AT    &kp LPAR  &kp RPAR  &kp COLON    &kp CARET  &kp HASH   &kp DLLR   &kp PRCNT  &kp AMPS  &kp DEL
&kp GRAVE  &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC  &kp DOT      &kp FSLH   &kp MINUS  &kp EQUAL  &kp SEMI   &kp DQT   &kp STAR
&trans     &kp LT    &kp GT    &kp PIPE  &kp BSLH  &kp COMMA    &kp QMARK  &kp UNDER  &kp PLUS   &kp EXCL   &kp BSLH  &trans
                               &trans    &trans    &trans       &trans     &trans     &trans
            >;
        };

        // Layer 2: NUMBERS (Numpad rechts)

        number_layer {
            label = "NUMBERS";
            bindings = <
&trans  &kp N1    &kp N2    &kp N3     &kp N4     &kp N5    &kp N6     &kp N7  &kp N8   &kp N9  &kp N0     &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none     &kp PLUS   &kp N4  &kp N5   &kp N6  &kp MINUS  &kp STAR
&trans  &none     &none     &none      &none      &none     &kp EQUAL  &kp N1  &kp N2   &kp N3  &kp FSLH   &trans
                            &trans     &trans     &trans    &trans     &kp N0  &kp DOT
            >;
        };

        // Layer 3: NAVIGATION (Vim-style + macOS shortcuts)

        nav_layer {
            label = "NAV";
            bindings = <
&to 0   &none      &none      &none         &none      &none     &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &none         &trans
&trans  &kp LCTRL  &kp LALT   &kp LEFT_GUI  &none      &none     &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp UP_ARROW  &none
&trans  &kp LG(Z)  &kp LG(X)  &kp LG(C)     &kp LG(V)  &none     &none     &none      &none      &kp LEFT   &kp DOWN      &kp RIGHT
                              &trans        &trans     &trans    &trans    &trans     &trans
            >;
        };

        // Layer 4: SYSTEM (Bluetooth, Media, Screenshot)

        system_layer {
            label = "SYS";
            bindings = <
&to 0       &bt BT_SEL 0  &bt BT_SEL 1  &none   &none   &none     &kp K_MUTE  &kp C_VOL_DN  &kp C_VOLUME_UP  &none  &none  &kp PSCRN
&none       &none         &none         &none   &none   &none     &none       &none         &none            &none  &none  &none
&bt BT_CLR  &none         &none         &none   &none   &none     &none       &none         &none            &none  &none  &none
                                        &trans  &trans  &trans    &trans      &trans        &trans
            >;
        };
    };
};
