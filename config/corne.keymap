/*
 * Corne 3x6 TypeScript Layout with Home Row Mods
 * Thumb cluster: NAV | NUM | SPC | RET | SYM | SYS
 * Layer 4 (SYS) via mo 4 (outer-right thumb)
 *
 * Häufigste Sonderzeichen:
 * . (13.5%), () (22.2%), ' (9.7%), ; (8.6%), / (7.7%), , (7.6%), {} (13.4%), : (6.6%)
 *
 * SPDX-License-Identifier: GPL-2.0-or-later
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {


    behaviors {
        // Home Row Mods - macOS optimiert

        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35>;  // Rechte Hand + Daumen
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29>;  // Linke Hand + Daumen
            hold-trigger-on-release;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: BASE (QWERTY mit Home Row Mods)

        base_layer {
            label = "BASE";
            bindings = <
&kp ESC    &kp Q          &kp W         &kp E         &kp R     &kp T         &kp Y      &kp U     &kp I         &kp O         &kp P             &kp BSPC
&kp TAB    &hm_l LCTRL A  &hm_l LALT S  &hm_l LSHFT D  &hm_l LGUI F     &kp G         &kp H      &hm_r RGUI J     &hm_r RSHFT K  &hm_r RALT L  &hm_r RCTRL SEMI  &kp SQT
&kp LSHFT  &kp Z          &kp X         &kp C         &kp V     &kp B         &kp N      &kp M     &kp COMMA     &kp DOT       &kp FSLH          &kp RSHFT
                                        &mo 3         &mo 2     &kp SPACE     &kp RET    &mo 1      &mo 4
            >;
        };

        // Layer 1: SYMBOL (TypeScript-optimiert nach Häufigkeit)

        symbol_layer {
            label = "SYMBOL";
            bindings = <
&kp TILDE  &kp EXCL  &kp AT    &kp LPAR  &kp RPAR  &kp COLON    &kp CARET  &kp HASH   &kp DLLR   &kp PRCNT  &kp AMPS  &trans
&kp GRAVE  &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC  &kp DOT      &kp FSLH   &kp MINUS  &kp EQUAL  &kp SEMI   &kp DQT   &kp STAR
&trans     &kp LT    &kp GT    &kp PIPE  &kp BSLH  &kp COMMA    &kp QMARK  &kp UNDER  &kp PLUS   &kp EXCL   &kp BSLH  &trans
                               &trans    &trans    &trans       &trans     &trans     &trans
            >;
        };

        // Layer 2: NUMBERS (Numpad rechts)

        number_layer {
            label = "NUMBERS";
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6    &kp N7     &kp N8     &kp N9   &kp N0    &trans
&trans  &none   &none   &none   &none   &none     &kp PLUS  &kp MINUS  &kp STAR   &kp FSLH  &none    &none
&trans  &none   &none   &none   &none   &none     &kp EQUAL &none      &kp COMMA  &kp DOT  &kp FSLH  &trans
                        &trans  &trans  &trans    &trans    &trans     &trans
            >;
        };

        // Layer 3: NAVIGATION (Vim-style + macOS shortcuts)

        nav_layer {
            label = "NAV";
            bindings = <
&to 0   &none        &none        &none         &none        &none     &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &none         &trans
&trans  &kp LCTRL   &kp LALT     &kp LSHFT     &kp LGUI     &none     &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp UP_ARROW  &none
&trans  &none        &none        &none         &none        &none     &none     &none      &none      &kp LEFT   &kp DOWN      &kp RIGHT
                              &trans        &trans     &trans    &trans    &trans     &trans
            >;
        };

        // Layer 4: SYSTEM (Bluetooth, Media, Screenshot)

        system_layer {
            label = "SYS";
            bindings = <
&to 0       &bt BT_SEL 0  &bt BT_SEL 1  &none   &none   &none     &kp K_MUTE  &kp C_VOL_DN  &kp C_VOLUME_UP  &none  &none  &trans
&none       &none         &none         &none   &none   &none     &none       &none         &none            &none  &none  &none
&bt BT_CLR  &none         &none         &none   &none   &none     &none       &none         &none            &none  &none  &none
                                        &trans  &trans  &trans    &trans      &trans        &trans
            >;
        };
    };
};
