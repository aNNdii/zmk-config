#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 29 27 28 29>;
            hold-trigger-on-release;
            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            hold-trigger-on-release;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ComboCopy {
            bindings = <&kp K_COPY>;
            key-positions = <26 27>;
            layers = <0>;
        };

        ComboCut {
            bindings = <&kp K_CUT>;
            key-positions = <25 26>;
            layers = <0>;
        };

        ComboPaste {
            bindings = <&kp K_PASTE>;
            key-positions = <27 28>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Characters {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp GRAVE  &kp Q            &kp W            &kp E                &kp R         &kp T          &kp Z        &kp U            &kp I                 &kp O             &kp P                &kp BSPC
&kp TAB    &HML LEFT_GUI A  &HML LEFT_ALT S  &HML LEFT_CONTROL D  &kp F         &kp G          &kp H        &kp J            &HMR RIGHT_CONTROL K  &HMR RIGHT_ALT L  &HMR RIGHT_GUI SEMI  &kp SQT
&kp LSHFT  &kp Y            &kp X            &kp C                &kp V         &kp B          &kp N        &kp M            &kp COMMA             &kp DOT           &kp SLASH            &kp RIGHT_SHIFT
                                             &kp LEFT_GUI         &lt 4 ESCAPE  &lt 3 SPACE    &lt 1 ENTER  &lt 2 BACKSPACE  &kp RIGHT_ALT
            >;
        };

        Numbers {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5       &kp N6   &kp N7  &kp N8  &kp N9  &kp N0  &kp BSPC
&trans     &trans  &trans  &trans  &trans  &trans       &trans   &trans  &trans  &trans  &trans  &trans
&kp LSHFT  &trans  &trans  &trans  &trans  &trans       &trans   &trans  &trans  &trans  &trans  &kp RIGHT_SHIFT
                           &trans  &trans  &kp SPACE    &kp RET  &trans  &trans
            >;
        };

        Symbols {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR      &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &trans  &trans    &trans        &trans       &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans    &trans  &trans    &trans        &trans       &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                             &trans    &kp LEFT_GUI  &kp SPACE    &kp RET    &trans     &trans
            >;
        };

        Navigation {
            bindings = <
&trans  &trans        &trans        &trans            &trans  &trans       &trans          &trans          &trans        &trans          &trans    &trans
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &trans  &trans       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp LEFT_ARROW  &kp HOME  &kp PG_UP
&trans  &trans        &trans        &trans            &trans  &trans       &trans          &trans          &trans        &trans          &kp END   &kp PG_DN
                                    &trans            &trans  &kp SPACE    &kp ENTER       &trans          &trans
            >;
        };

        System {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &trans  &trans  &trans  &bt BT_CLR    &trans     &trans  &trans  &trans  &trans  &kp PRINTSCREEN
&trans        &trans        &trans  &trans  &trans  &trans        &trans     &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans  &trans  &trans  &trans        &trans     &trans  &trans  &trans  &trans  &trans
                                    &trans  &trans  &kp SPACE     &kp ENTER  &trans  &trans
            >;
        };
    };
};
