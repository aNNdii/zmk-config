#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp E      &kp R         &kp T          &kp Z        &kp U                      &kp I          &kp O    &kp P     &kp BACKSPACE
&kp TAB     &kp A  &kp S  &kp D      &kp F         &kp G          &kp H        &kp J                      &kp K          &kp L    &kp SEMI  &kp SINGLE_QUOTE
&sk LSHFT   &kp Y  &kp X  &kp C      &kp V         &kp B          &kp N        &kp M                      &kp COMMA      &kp DOT  &kp FSLH  &sk RIGHT_SHIFT
                          &sk LCTRL  &sk LEFT_GUI  &lt 1 SPACE    &lt 2 ENTER  &sk RS(RA(RC(RIGHT_GUI)))  &sk RIGHT_ALT
            >;
        };

        lower {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN   &kp POUND     &kp DOLLAR        &kp PERCENT       &kp CARET        &kp AMPERSAND      &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4      &kp NUMBER_5      &kp NUMBER_6     &kp NUMBER_7       &kp NUMBER_8  &kp NUMBER_9          &kp NUMBER_0           &none
&none   &none            &kp TILDE     &kp GRAVE     &kp LEFT_BRACKET  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp COMMA     &kp DOT               &kp SLASH              &none
                                       &trans        &trans            &trans            &trans           &trans             &trans
            >;
        };

        raise {
            bindings = <
&trans  &kp HOME       &none             &kp UNDERSCORE  &kp PLUS   &kp PAGE_UP      &none     &none     &none         &kp BACKSLASH  &kp PIPE  &trans
&none   &kp END        &none             &kp MINUS       &kp EQUAL  &kp PAGE_DOWN    &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT      &none     &none
&none   &kp LESS_THAN  &kp GREATER_THAN  &none           &none      &none            &none     &none     &none         &none          &none     &none
                                         &trans          &trans     &trans           &trans    &trans    &trans
            >;
        };

        system {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &none  &none   &none   &none     &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &none   &none  &none  &kp PRINTSCREEN
&none         &none         &none  &none   &none   &none     &none            &none              &none   &none  &none  &none
&bt BT_CLR    &none         &none  &none   &none   &none     &none            &none              &none   &none  &none  &none
                                   &trans  &trans  &trans    &trans           &trans             &trans
            >;
        };
    };
};
