#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        TDRightShift: TDRightShift {
            compatible = "zmk,behavior-tap-dance";
            label = "TDRIGHTSHIFT";
            #binding-cells = <0>;
            bindings = <&sk RIGHT_SHIFT>, <&tog 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp E         &kp R         &kp T          &kp Y        &kp U          &kp I              &kp O    &kp P     &kp BACKSPACE
&kp TAB     &kp A  &kp S  &kp D         &kp F         &kp G          &kp H        &kp J          &kp K              &kp L    &kp SEMI  &kp SINGLE_QUOTE
&sk LSHFT   &kp Z  &kp X  &kp C         &kp V         &kp B          &kp N        &kp M          &kp COMMA          &kp DOT  &kp FSLH  &TDRightShift
                          &sk LEFT_ALT  &sk LEFT_GUI  &lt 1 SPACE    &lt 2 ENTER  &sk RIGHT_GUI  &sk RIGHT_CONTROL
            >;

            label = "qwerty";
        };

        numbers {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN      &kp POUND        &kp DOLLAR       &kp PERCENT        &kp CARET  &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&none   &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5    &kp GRAVE  &kp TILDE      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp COLON              &kp DQT
&trans  &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0    &kp MINUS  &kp EQUAL      &kp LESS_THAN     &kp GREATER_THAN      &kp SLASH              &kp BACKSLASH
                                          &trans           &trans           &trans             &trans     &trans         &trans
            >;

            label = "numbers";
        };

        navi {
            bindings = <
&trans  &none  &none  &none   &kp HOME  &kp PAGE_UP      &none     &none     &none         &none      &none  &trans
&none   &none  &none  &none   &kp END   &kp PAGE_DOWN    &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &none  &none
&none   &none  &none  &none   &none     &none            &none     &none     &none         &none      &none  &none
                      &trans  &trans    &trans           &trans    &trans    &trans
            >;

            label = "navi";
        };

        system {
            bindings = <
&tog 3      &bt BT_SEL 0  &bt BT_SEL 1  &none   &none   &none     &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &none  &none  &kp PRINTSCREEN
&none       &none         &none         &none   &none   &none     &none       &none              &none            &none  &none  &none
&bt BT_CLR  &none         &none         &none   &none   &none     &none       &none              &none            &none  &none  &none
                                        &trans  &trans  &trans    &trans      &trans             &trans
            >;

            label = "system";
        };
    };
};
